APP_NAME=REDFLOW
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# IMPORTANT: without this, Laravel defaults to UTC (8 hours behind
# Philippine time) for every timestamp it generates server-side — login
# times, Audit Log entries, User Log entries, notification messages, all of
# it. This was previously missing from this file, which is exactly what was
# causing login times and Audit Log timestamps to show the wrong AM/PM.
APP_TIMEZONE=Asia/Manila

LOG_CHANNEL=stack
LOG_LEVEL=debug

# XAMPP/local MySQL defaults — adjust if different
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=redflow_db
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120

# Mail — used to send the real Forgot Password OTP code.
# Leave MAIL_MAILER=log while testing locally: the OTP will be written to
# storage/logs/laravel.log instead of actually emailed, so you can still
# copy the code out and test the flow without any SMTP setup.
#
# To send real emails via Gmail SMTP once you're ready:
#   MAIL_MAILER=smtp
#   MAIL_HOST=smtp.gmail.com
#   MAIL_PORT=587
#   MAIL_USERNAME=adminredflow402@gmail.com
#   MAIL_PASSWORD=your-16-character-gmail-app-password   (NOT your normal Gmail password)
#   MAIL_ENCRYPTION=tls
#   MAIL_FROM_ADDRESS=adminredflow402@gmail.com
#   MAIL_FROM_NAME="${APP_NAME}"
#
# If you get "Connection could not be established with host smtp.gmail.com:587"
# / "No such host is known" — that is your PC failing to even reach Gmail's
# server over the network, not a bug in the code. In order of what to try:
#   1. Confirm this PC actually has working internet right now (not just the
#      browser — some school/campus/mobile-data networks route browser
#      traffic through a proxy that still works even when raw outbound
#      connections from PHP do not).
#   2. Many school/campus WiFi networks block outbound SMTP ports (587, 465,
#      25) entirely to stop spam, while still allowing normal web browsing.
#      Try a mobile hotspot instead to check if that's the cause.
#   3. Try port 465 with SSL instead of 587 with TLS — some networks block
#      one but not the other:
#        MAIL_PORT=465
#        MAIL_ENCRYPTION=ssl
#   4. Temporarily disable Windows Firewall / antivirus to rule out local
#      blocking.
#   5. If SMTP is blocked no matter what, switch to an HTTP-based email
#      provider instead (Resend, Brevo, Mailgun) — these send over normal
#      HTTPS (443), which is almost never blocked. That needs a different
#      Laravel mail driver, so ask for help wiring it up if you get this far.
MAIL_MAILER=log
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@redflow.local"
MAIL_FROM_NAME="${APP_NAME}"
